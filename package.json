{
  "name": "elven.js-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "packages/*",
    "configs/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "setup:dev-certs": "node setup-dev-certs.js",
    "dev:server": "npm run setup:dev-certs && node dev-server.js",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "prettier": "turbo run prettier",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@configs/esbuild": "workspace:*",
    "@configs/eslint-config": "workspace:*",
    "@configs/tsconfig": "workspace:*",
    "@types/node": "22.13.4",
    "esbuild": "0.25.0",
    "eslint": "9.20.1",
    "prettier": "3.5.1",
    "rimraf": "6.0.1",
    "serve-handler": "6.1.6",
    "turbo": "2.4.2",
    "typescript": "5.7.3"
  },
  "overrides": {
    "ellipsis": "6.6.1"
  }
}